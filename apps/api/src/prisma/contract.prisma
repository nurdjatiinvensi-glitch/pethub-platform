// use prisma-8

model Donor {
  id        String   @id @default(uuid())
  phone     String   @unique
  name      String
  email     String?
  accountId String?

  orders    FeedCareOrder[]

  createdAt TimestamptzString @default(now())
  updatedAt temporal.updatedAtString()
}

model FeedCarePackage {
  id          String   @id @default(uuid())
  name        String
  meals       Int
  price       Int
  description String?
  isActive    Boolean  @default(true)

  orders      FeedCareOrder[]

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model FeedCareOrder {
  id             String   @id @default(uuid())
  orderNumber    String   @unique

  donor          Donor          @relation(fields: [donorId], references: [id])
  donorId        String

  package        FeedCarePackage @relation(fields: [packageId], references: [id])
  packageId      String

  quantity       Int      @default(1)
  mealsPurchased Int
  totalAmount    Int

  status         String   @default("PENDING")

  payment        Payment?

  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model Payment {
  id              String   @id @default(uuid())

  order          FeedCareOrder @relation(fields: [orderId], references: [id])
  orderId        String   @unique

  amount          Int
  paidAmount      Int?
  method          String
  status          String   @default("PENDING")

  proofUrl        String?
  rejectionReason String?

  paidAt          TimestamptzString?
  verifiedAt      TimestamptzString?

  createdAt       TimestamptzString @default(now())
  updatedAt       temporal.updatedAtString()
}


model Category {
  id            String        @id @default(uuid())
  name          String
  description   String?
  isActive      Boolean       @default(true)

  subcategories Subcategory[]
  items         Item[]

  createdAt     TimestamptzString @default(now())
  updatedAt     temporal.updatedAtString()
}

model Subcategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true)

  category    Category @relation(fields: [categoryId], references: [id])
  categoryId  String

  items       Item[]

  createdAt   TimestamptzString @default(now())
  updatedAt   temporal.updatedAtString()
}

model Item {
  id             String   @id @default(uuid())
  itemCode       String   @unique
  name           String
  itemType       String   @default("PRODUCT")
  description    String?
  price          Int      @default(0)
  imageUrl       String?
  isActive       Boolean  @default(true)

  category       Category @relation(fields: [categoryId], references: [id])
  categoryId     String

  subcategory    Subcategory @relation(fields: [subcategoryId], references: [id])
  subcategoryId  String

  ownerType      String   @default("PETHUB")
  ownerId        String?

  specifications ItemSpecification[]

  createdAt      TimestamptzString @default(now())
  updatedAt      temporal.updatedAtString()
}

model ItemSpecification {
  id       String @id @default(uuid())
  name     String
  value    String

  item     Item   @relation(fields: [itemId], references: [id])
  itemId   String
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?
  action    String
  entity    String
  entityId  String
  oldValue  String?
  newValue  String?
  createdAt TimestamptzString @default(now())
}
